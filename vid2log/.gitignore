python_sidecar/.venv/
python_sidecar/build/
python_sidecar/dist/
python_sidecar/__pycache__/
python_sidecar/**/__pycache__/
*.pyc

# Release outputs — regenerate via scripts/build_macos.sh / build_windows.ps1
/dist/
