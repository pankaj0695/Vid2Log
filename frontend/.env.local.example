# Copy to .env.local and fill in — these are the same Firebase *web app*
# config values documented in backend/.env.example (FIREBASE_*), just
# NEXT_PUBLIC_-prefixed so Next.js bundles them for the browser. None of
# these are secret; Firebase web config is meant to be public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base URL of the FastAPI backend (backend/app/main.py). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The real, public URL this frontend is deployed at (no trailing slash) —
# used for SEO: metadataBase, canonical links, the sitemap, and Open
# Graph/Twitter preview URLs (lib/site.ts). Falls back to
# http://localhost:3000 if unset, which is fine for local dev but WRONG in
# production — set this to your real domain once deployed, e.g.
# https://vid2log.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
